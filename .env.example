# ============================================================================
# Curevia Healthcare - Environment Configuration (.env)
# Official Tagline: "Precision Care, Verified Deliveries"
# ============================================================================

# Supabase (PostgreSQL) Cloud Database Credentials
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Local MySQL Database Fallback (Optional)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=curevia_db

# Flask Session Security & Upload Limits
SECRET_KEY=curevia-secure-session-key-2026-precision-care
FLASK_ENV=development
FLASK_DEBUG=1
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH=16777216
